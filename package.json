{
  "name": "proyecto-c",
  "version": "0.0.0",
  "private": true,
  "description": "Workload planner with an explainable priority engine (provisional name).",
  "engines": {
    "node": ">=24",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel run dev",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "pnpm db:test:prepare && vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "mutate": "tsx tools/review/mutate.ts",
    "review:packet": "tsx tools/review/packet.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @proyecto-c/api run db:migrate",
    "db:test:prepare": "pnpm --filter @proyecto-c/api run db:test:prepare",
    "db:seed": "node -e \"console.error('Seed is not configured yet (P3-T1): nothing to seed.'); process.exit(1)\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
