{
  "name": "proyecto-c",
  "version": "0.0.0",
  "private": true,
  "description": "Workload planner with an explainable priority engine (provisional name).",
  "engines": {
    "node": "22.17.0",
    "pnpm": "11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm -r --if-present --parallel run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
