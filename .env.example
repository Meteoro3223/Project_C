# Copy to `.env` for local development. Never commit `.env` (see `.gitignore`).
# Used by `docker-compose.yml` (`db` service) and by Prisma from P0-T4 onwards.
# The values below are dev-only defaults and match `docker-compose.yml`, so a
# plain copy works out of the box. The password is not a secret.

# API port (`apps/api` reads `PORT` with a default of 4010).
PORT=4010

# Postgres container (`db` service)
POSTGRES_USER=proyecto_c
POSTGRES_PASSWORD=proyecto_c_dev
POSTGRES_DB=proyecto_c_dev
POSTGRES_PORT=5432

# Development database (Prisma, wired in P0-T4)
DATABASE_URL=postgresql://proyecto_c:proyecto_c_dev@localhost:5432/proyecto_c_dev?schema=public

# Test database lives on the same `db` service under a different name.
# `pnpm db:test:prepare` creates it if needed and applies migrations; keep it
# separate from development so tests never touch dev data.
TEST_DATABASE_URL=postgresql://proyecto_c:proyecto_c_dev@localhost:5432/proyecto_c_test?schema=public
