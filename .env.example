# Copy to `.env` for local development. Never commit `.env` (see `.gitignore`).
# Used by `docker-compose.yml` (`db` service) and by Prisma from P0-T4 onwards.

# Postgres container (`db` service)
POSTGRES_USER=proyecto_c
POSTGRES_PASSWORD=change_me_in_.env
POSTGRES_DB=proyecto_c_dev
POSTGRES_PORT=5432

# Development database (Prisma, wired in P0-T4)
DATABASE_URL=postgresql://proyecto_c:change_me_in_.env@localhost:5432/proyecto_c_dev?schema=public

# Test database lives on the same `db` service under a different name.
# It is created on demand by the Prisma/test setup (see P2-T1); keep it
# separate from development so tests never touch dev data.
TEST_DATABASE_URL=postgresql://proyecto_c:change_me_in_.env@localhost:5432/proyecto_c_test?schema=public
